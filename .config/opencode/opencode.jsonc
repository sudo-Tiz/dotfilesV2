{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    "read": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "ls *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "file *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "git diff *": "allow",
      "git status *": "allow",
      "git ls-files *": "allow",
      "git show *": "allow"
    }
  }
}
