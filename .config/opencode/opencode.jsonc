{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail",
    "opencode-caveman"
  ],
  "skill": ["caveman"],
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "grep /home/*": "allow",
      "ls /home/*": "allow",
      "file /home/*": "allow",
      "cat /home/*": "allow",
      "which /home/*": "allow"
    }
  }
}
