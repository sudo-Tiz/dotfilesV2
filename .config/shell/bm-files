# These files automatically update when edited/saved in vim:

# keys	filename				description
bmf	${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-files	# This file, a list of bookmarked files
bmd	${XDG_CONFIG_HOME:-$HOME/.config}/shell/bm-dirs		# A list of bookmarked directories similar to this file
#
# These do not update automatically, but on the next new instance of a program:
cfv	${XDG_CONFIG_HOME:-$HOME/.config}/nvim/lua/ # nvim config
cfz	$ZDOTDIR/.zshrc						# zsh (shell) config
cfa	${XDG_CONFIG_HOME:-$HOME/.config}/shell/aliasrc		# aliases used by zsh (and potentially other shells)
cfp	${XDG_CONFIG_HOME:-$HOME/.config}/shell/profile		# profile file for login settings for zsh
cft	${XDG_CONFIG_HOME:-$HOME/.config}/tmux/tmux.conf # Tmux config
cfh ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua		# Hyprland config
cfn ${XDG_CONFIG_HOME:-$HOME/.config}/noctalia/noctalia-config.toml # Noctalia (status bar) config

